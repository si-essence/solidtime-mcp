# Sent only as Authorization: Bearer. Never printed. At least 8 characters.
SOLIDTIME_API_TOKEN=

# Instance origin. Default https://app.solidtime.io. A trailing /api is stripped.
# No userinfo, query, or hash.
SOLIDTIME_URL=https://app.solidtime.io

# Optional organization UUID. When unset, a single membership from
# GET /v1/users/me/memberships is used. Required when the user has more than one.
SOLIDTIME_ORGANIZATION_ID=

# The literal true enables writes. Any other value keeps writes as a blocked preview.
SOLIDTIME_ALLOW_WRITES=false

# Contact embedded in the User-Agent. Must not be the API token.
SOLIDTIME_CONTACT=you@example.com

# Local sliding window. Cache hits do not spend it. Solidtime allows 200/min.
SOLIDTIME_PER_MINUTE=200

# Cache TTL in seconds. 0 disables caching.
SOLIDTIME_CACHE_TTL_SEC=60

# Upstream timeout in milliseconds.
SOLIDTIME_TIMEOUT_MS=20000

# stdio (default) or http. --http on the command line forces http.
MCP_TRANSPORT=stdio
PORT=3000
